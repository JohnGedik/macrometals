NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: for API handlers using @supabase/server
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWKS_URL=

# Only needed by server-only code that intentionally bypasses RLS
SUPABASE_SECRET_KEY=

# Defaults are off; enable only when the corresponding rights-register record covers this deployment.
YAHOO_FINANCE_AUTOMATED_ACCESS_CONFIRMED=false
MARKET_DATA_PUBLIC_DISTRIBUTION_CONFIRMED=false
FRED_M2SL_PUBLIC_USE_CONFIRMED=false
FRED_T5YIE_PUBLIC_USE_CONFIRMED=false
FRED_DFII10_PUBLIC_USE_CONFIRMED=false
FRED_DTWEXBGS_PUBLIC_USE_CONFIRMED=false

# FRED archival is prohibited unless separately permitted for each series.
SOURCE_ARCHIVE_ENABLED=false
FRED_ARCHIVE_PERMITTED_SERIES=

# Server-only FRED API access
FRED_API_KEY=

# WGC workbook automation is download-only; use a host scheduler and keep the workbook in memory.
WGC_CENTRAL_BANK_GOLD_AUTOMATION_CONFIRMED=false
WGC_CENTRAL_BANK_GOLD_PUBLIC_USE_CONFIRMED=false
WGC_GOLD_ETF_PUBLIC_USE_CONFIRMED=false
CFTC_COT_GOLD_PUBLIC_USE_CONFIRMED=false
GPR_CI_PUBLIC_USE_CONFIRMED=false
CRON_SECRET=

# Optional: EIA weekly crude inventories (server only)
EIA_API_KEY=